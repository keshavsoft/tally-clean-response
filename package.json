{
  "name": "tally-clean-response",
  "version": "1.2.1",
  "description": "Clean, sanitize, and normalize raw JSON from Tally ERP 9 and TallyPrime XML responses into plain JavaScript objects",
  "type": "module",
  "main": "src/index.js",
  "module": "./src/index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./v1": {
      "types": "./index.d.ts",
      "import": "./src/v1/index.js",
      "default": "./src/v1/index.js"
    },
    "./v2": {
      "types": "./index.d.ts",
      "import": "./src/v2/index.js",
      "default": "./src/v2/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node Test/test.js"
  },
  "keywords": [
    "tally",
    "tally-prime",
    "tally-erp9",
    "tdl",
    "xml-to-json",
    "clean",
    "sanitize",
    "normalize",
    "fast-xml-parser"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "homepage": "https://keshavsoft.github.io/tally-clean-response/",
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-clean-response"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/tally-clean-response/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "tally-to-xml-tdl": "^1.6.1"
  }
}